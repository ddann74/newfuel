# Android Studio / Gradle build output and local machine config - none of
# this should be committed, it's regenerated by Android Studio/Gradle and
# local.properties specifically contains a machine-local Android SDK path.
android/local.properties
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/*.iml
android/app/*.iml

# Python
__pycache__/
*.pyc
