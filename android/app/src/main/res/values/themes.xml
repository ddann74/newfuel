<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar: the web page already renders its own header (see
         .header in style.css) - a native app bar on top of that would just
         duplicate it. -->
    <style name="Theme.FuelOptimizer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/brand_blue</item>
    </style>
</resources>
